{
  "name": "git-atlas",
  "displayName": "Git Atlas",
  "description": "Transform Git into an interactive visual state machine graph. Understand Git through visualization, not commands.",
  "version": "0.1.6",
  "publisher": "varunkarli",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/arcaneleague18/GitAtlas"
  },
  "sponsor": {
    "url": "https://www.buymeacoffee.com/varunkarli"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "SCM Providers",
    "Visualization",
    "AI",
    "Chat"
  ],
  "icon": "resources/icons/main_icon.png",
  "keywords": [
    "git",
    "graph",
    "visualization",
    "tree",
    "explorer",
    "state machine"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gitAtlas",
          "title": "Git Atlas",
          "icon": "resources/icons/main_icon.png"
        }
      ]
    },
    "views": {
      "gitAtlas": [
        {
          "id": "gitAtlas.sidebar",
          "name": "Repository",
          "icon": "resources/icons/main_icon.png"
        },
        {
          "id": "gitAtlas.aiAssistant",
          "name": "AI Assistant",
          "type": "webview",
          "icon": "resources/icons/main_icon.png"
        }
      ]
    },
    "commands": [
      {
        "command": "gitAtlas.openGraph",
        "title": "Open Commit Graph",
        "category": "Git Atlas",
        "icon": "$(graph)"
      },
      {
        "command": "gitAtlas.refresh",
        "title": "Refresh",
        "category": "Git Atlas",
        "icon": "$(refresh)"
      },
      {
        "command": "gitAtlas.initRepository",
        "title": "Initialize Repository",
        "category": "Git Atlas",
        "icon": "$(add)"
      },
      {
        "command": "gitAtlas.publishToGitHub",
        "title": "Publish to GitHub",
        "category": "Git Atlas",
        "icon": "$(github)"
      },
      {
        "command": "gitAtlas.firstCommit",
        "title": "Create First Commit",
        "category": "Git Atlas",
        "icon": "$(check)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "gitAtlas.openGraph",
          "when": "view == gitAtlas.sidebar",
          "group": "navigation@1"
        },
        {
          "command": "gitAtlas.refresh",
          "when": "view == gitAtlas.sidebar",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "Git Atlas",
      "properties": {
        "gitAtlas.ai.provider": {
          "type": "string",
          "order": 1,
          "enum": [
            "vscode-lm",
            "openai",
            "lm-proxy",
            "openrouter",
            "groq",
            "nvidia",
            "ollama",
            "custom"
          ],
          "default": "vscode-lm",
          "description": "AI provider to use. 'vscode-lm' uses your installed VS Code language model (e.g., GitHub Copilot). Other options use compatible API keys."
        },
        "gitAtlas.ai.model": {
          "type": "string",
          "order": 2,
          "default": "gpt-4o-mini",
          "description": "Model ID to use (e.g., gpt-4o-mini, llama3-8b-8192, etc.)."
        },
        "gitAtlas.ai.apiKey": {
          "type": "string",
          "order": 3,
          "default": "",
          "description": "Your API key for the selected AI provider (not needed for vscode-lm or ollama)."
        },
        "gitAtlas.ai.baseUrl": {
          "type": "string",
          "order": 4,
          "default": "https://api.openai.com/v1",
          "description": "Base URL for OpenAI-compatible API. This auto-updates when you change the AI provider, but you can override it."
        },
        "gitAtlas.showLostCommits": {
          "type": "boolean",
          "default": false,
          "description": "Show orphaned commits from the reflog (commits no longer referenced by any branch). Enables time-travel recovery."
        },
        "gitAtlas.maxCommits": {
          "type": "number",
          "default": 500,
          "minimum": 50,
          "maximum": 10000,
          "description": "Maximum number of commits to load in the graph. Increase for larger repositories."
        }
      }
    }
  },
  "scripts": {
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "build:webview": "cd webview && npm run build",
    "build": "npm run build:webview && npm run compile",
    "lint": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.3.0"
  }
}
